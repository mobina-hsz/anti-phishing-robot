BOT_TOKEN=replace_with_a_new_bot_token
# Numeric Telegram user IDs, separated by commas. Empty disables admin commands.
ADMIN_IDS=
REQUEST_TIMEOUT=10
SCAN_TIMEOUT=40
MAX_CONCURRENT_SCANS=3
MAX_URLS_PER_MESSAGE=3
USER_COOLDOWN_SECONDS=5
MAX_EXTERNAL_SCRIPTS=4
MAX_RESPONSE_BYTES=1048576
MONITOR_DB=data/monitor.sqlite3
LOG_LEVEL=INFO
